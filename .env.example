# Copy to .env and fill in. NEVER commit .env. Placeholders only below.
# Generate secrets with:  backend\.venv\Scripts\python.exe -c "import secrets;print(secrets.token_urlsafe(50))"

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker-compose publishes it on host port 5433)
POSTGRES_DB=securevault
POSTGRES_USER=securevault
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Redis (Channels layer, cache, throttling)
REDIS_URL=redis://127.0.0.1:6379/0

# Browser origins allowed to call the API (Vite dev server)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret for the audit-log hash chain (HMAC). Random, >= 32 bytes. Separate from every other key.
AUDIT_HMAC_KEY=change-me

# --- Reserved for the vault-crypto phase. Kept separate on purpose. ---
# 32 random bytes, base64. Key-encryption key (wraps per-record data keys).
VAULT_KEK_V1=
VAULT_KEK_ACTIVE_VERSION=1
# 32 random bytes, base64. MUST differ from the KEK. Used only for HMAC blind indexes.
VAULT_BLIND_INDEX_KEY=
